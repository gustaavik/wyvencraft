/target
.cargo/config.toml
# Runtime state. These live in the OS application-data directory by default
# (see src/paths.rs); they appear here only when WYVEN_DATA_DIR=. pins them
# to the checkout, which is what `make run` does.
# World saves + local player profile (generated at runtime)
/saves
/profile.toml
# Command authorization list (per-world, holds account ids)
/ops.toml
# Cached auth-server public keys, fetched at sign-in (public, but generated)
/authkeys.toml
/servers.toml

# macOS Finder metadata
.DS_Store
wyvencraft.code-workspace